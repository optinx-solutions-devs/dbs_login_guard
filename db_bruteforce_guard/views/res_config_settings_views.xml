<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_db_guard_config_tree" model="ir.ui.view">
        <field name="name">db.guard.config.tree</field>
        <field name="model">db.guard.config</field>
        <field name="arch" type="xml">
            <tree string="Brute Force Configurations">
                <field name="name"/>
                <field name="active"/>
                <field name="failure_window_minutes"/>
                <field name="alert_after"/>
                <field name="block_after"/>
                <field name="geo_enabled"/>
            </tree>
        </field>
    </record>

    <record id="view_db_guard_config_form" model="ir.ui.view">
        <field name="name">db.guard.config.form</field>
        <field name="model">db.guard.config</field>
        <field name="arch" type="xml">
            <form string="Brute Force Configuration">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="failure_window_minutes"/>
                            <field name="alert_after"/>
                            <field name="block_after"/>
                            <field name="geo_enabled"/>
                        </group>
                        <group>
                            <field name="alert_email_to" placeholder="security@example.com, admin@example.com" widget="text"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_db_guard_settings" model="ir.actions.act_window">
        <field name="name">Configuration</field>
        <field name="res_model">db.guard.config</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

    <record id="db_guard_config_default" model="db.guard.config">
        <field name="name">Default</field>
        <field name="active" eval="True"/>
        <field name="alert_after">5</field>
        <field name="block_after">10</field>
        <field name="failure_window_minutes">15</field>
        <field name="geo_enabled" eval="True"/>
    </record>
</odoo>
